PORT=3001

# --- Railway / production (required) ---
# Local .env is NOT copied into Docker (.dockerignore). Set every variable below in Railway → Variables.
# Use the SAME MONGO_URI as local if you linked the GitHub App while running locally.
#
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/dbname
# GITHUB_APP_ID=123456
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_WEBHOOK_SECRET=your-webhook-secret
# JWT_SECRET=long-random-string
# OAUTH_CALLBACK_BASE_URL=https://your-app.up.railway.app
# FRONTEND_BASE_URL=https://your-frontend.vercel.app
# GEMINI_API_KEY=your-google-ai-studio-key
#
# GitHub App settings (Developer settings → Your App):
#   Webhook URL:  https://your-app.up.railway.app/api/webhooks/github
#   Setup URL:    https://your-app.up.railway.app/api/github/setup
#   Events:       Pull request
#   Permissions:  Pull requests Read & write, Contents Read
#
# After deploy: GET https://your-app.up.railway.app/health → ok:true, mongodb:connected, githubApp.privateKeySet:true

# GitHub App (single registration; each user installs it on their own org)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Optional: full install URL if different from https://github.com/apps/<GITHUB_APP_SLUG>/installations/new
# GITHUB_APP_INSTALL_URL=https://github.com/apps/your-app-slug/installations/new
GITHUB_WEBHOOK_SECRET=
# PEM: set either multiline GITHUB_APP_PRIVATE_KEY (e.g. Railway secret) or a file path.
# GITHUB_APP_PRIVATE_KEY=
# Optional file path when not using GITHUB_APP_PRIVATE_KEY; defaults to github-app-key.pem next to the backend folder (not for production commits).
# GITHUB_APP_PRIVATE_KEY_PATH=

# OAuth client used by "Sign in with GitHub" (separate from the App)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Sessions (set to a long random string in production)
JWT_SECRET=change-me

# Public URLs (used to build OAuth redirect_uri and to redirect back to the SPA)
OAUTH_CALLBACK_BASE_URL=http://localhost:3001
FRONTEND_BASE_URL=http://localhost:5173

# Mongo (required in production — .env is NOT copied into Docker; set vars on Railway)
# Local: paste Atlas URI below. Railway: Variables → MONGO_URI = your mongodb+srv://… string
# Or link Railway MongoDB plugin and set: MONGO_URI=${{MongoDB.MONGO_URL}}
MONGO_URI=

# Google Gemini (official SDK — required for PR AI reviews)
# Create at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Large PRs = many sequential Gemini calls — optional throttle + retries on 429/503/timeouts
# AI_REVIEW_RETRY_MAX=5
# AI_REVIEW_RETRY_BASE_MS=15000
# AI_REVIEW_SEGMENT_DELAY_MS=5000
# AI_REVIEW_UPSTREAM_TIMEOUT_SEC=180

# Giant reviews + many inline comments can hit GitHub secondary rate limits (403 content creation). Cap payload size.
# GITHUB_REVIEW_BODY_MAX_CHARS=48000
# GITHUB_REVIEW_MAX_INLINE_COMMENTS=5
# GITHUB_REVIEW_PROSE_MAX_CHARS=28000
# GITHUB_REVIEW_BODY_ONLY=false
# GITHUB_REVIEW_ORPHAN_ROWS_MAX=64
# GITHUB_REVIEW_EMERGENCY_BODY_CHARS=12000
# GITHUB_REVIEW_SLIM_ORPHAN_ROWS=8
# Preemptive slim: body+comments JSON estimate (defaults: body>18k OR inline>5 OR payload>42k). Override with true|false.
# GITHUB_REVIEW_PREEMPTIVE_SLIM=
# GITHUB_REVIEW_PREEMPTIVE_BODY_BYTES=18000
# GITHUB_REVIEW_PREEMPTIVE_INLINE_MAX=5
# GITHUB_REVIEW_PREEMPTIVE_PAYLOAD_BYTES=42000

# PR diffs only contain changed files — huge segment counts are usually lockfiles. Exclude those from AI by default.
# DIFF_REVIEW_SKIP_LOCKFILES=true
# Comma-separated path substrings to drop from AI diff (in addition to lockfiles when SKIP_LOCKFILES=true).
# DIFF_REVIEW_EXCLUDE_PATH_CONTAINS=
# Only review paths starting with these prefixes (comma-separated, repo-relative). Empty = no restriction.
# DIFF_REVIEW_INCLUDE_PATH_PREFIXES=backend/,frontend/src/
# Hard cap on AI segment passes after filtering (default 25). Set 0 or unlimited for no cap.
# DIFF_REVIEW_MAX_AI_SEGMENTS=25

# Split large unified diffs into multiple AI passes (lines per segment; also capped by ~10k chars/segment).
# DIFF_REVIEW_MAX_LINES_PER_SEGMENT=400

# ast-grep (when RepoConfig.useAstGrep is true): scans PR head files with bundled rules under backend/ast-grep/
# Uses @ast-grep/cli from node_modules unless AST_GREP_BIN is set.
# AST_GREP_BIN=
# AST_GREP_CONFIG_DIR=ast-grep
# AST_GREP_MAX_FILES=40
# AST_GREP_MAX_FILE_BYTES=512000
# AST_GREP_TIMEOUT_MS=90000

# Optional scheduler tuning
# ENABLE_BUG_SCAN=true
# BUG_SCAN_INTERVAL_MINUTES=60
# BUG_SCAN_MAX_PRS_PER_REPO=10
# BUG_SCAN_POST_COMMENTS=false
# BUG_SCAN_SKIP_UNCHANGED=true
# BUG_SCAN_RUN_ON_START=false

# When true, PR reviews (webhook + scheduled scan) run only for users who have at least one non-revoked API key in the DB.
# The browser cannot send a pasted key to GitHub; this checks MongoDB only. Default: unset/false.
# REQUIRE_API_KEY_FOR_REVIEWS=true
