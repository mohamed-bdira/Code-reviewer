PORT=3001

# GitHub App (single registration; each user installs it on their own org)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Optional: full install URL if different from https://github.com/apps/<GITHUB_APP_SLUG>/installations/new
# GITHUB_APP_INSTALL_URL=https://github.com/apps/your-app-slug/installations/new
GITHUB_WEBHOOK_SECRET=
# PEM: set either multiline GITHUB_APP_PRIVATE_KEY (e.g. Railway secret) or a file path.
# GITHUB_APP_PRIVATE_KEY=
# Optional file path when not using GITHUB_APP_PRIVATE_KEY; defaults to github-app-key.pem next to the backend folder (not for production commits).
# GITHUB_APP_PRIVATE_KEY_PATH=

# OAuth client used by "Sign in with GitHub" (separate from the App)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Sessions (set to a long random string in production)
JWT_SECRET=change-me

# Public URLs (used to build OAuth redirect_uri and to redirect back to the SPA)
OAUTH_CALLBACK_BASE_URL=http://localhost:3001
FRONTEND_BASE_URL=http://localhost:5173

# Mongo
MONGO_URI=

# Python bridge (no cookies/tokens — see backend/scripts/pythonExploit.py header). On Linux hosts use python3.
PYTHON_BIN=python3
PYTHON_SCRIPT_PATH=scripts/pythonExploit.py

# Large PRs = many sequential Gemini/web calls — optional throttle + retries on HTTP 429/502/503/504-ish errors.
# AI_REVIEW_SEGMENT_DELAY_MS=2000
# AI_REVIEW_RETRY_MAX=3
# AI_REVIEW_RETRY_BASE_MS=2000

# Giant reviews + many inline comments can hit GitHub secondary rate limits (403 content creation). Cap payload size.
# GITHUB_REVIEW_BODY_MAX_CHARS=48000
# GITHUB_REVIEW_MAX_INLINE_COMMENTS=5
# GITHUB_REVIEW_PROSE_MAX_CHARS=28000
# GITHUB_REVIEW_BODY_ONLY=false
# GITHUB_REVIEW_ORPHAN_ROWS_MAX=64
# GITHUB_REVIEW_EMERGENCY_BODY_CHARS=12000
# GITHUB_REVIEW_SLIM_ORPHAN_ROWS=8
# Preemptive slim: body+comments JSON estimate (defaults: body>18k OR inline>5 OR payload>42k). Override with true|false.
# GITHUB_REVIEW_PREEMPTIVE_SLIM=
# GITHUB_REVIEW_PREEMPTIVE_BODY_BYTES=18000
# GITHUB_REVIEW_PREEMPTIVE_INLINE_MAX=5
# GITHUB_REVIEW_PREEMPTIVE_PAYLOAD_BYTES=42000

# Split large unified diffs into multiple AI passes (lines per segment; also capped by ~10k chars/segment).
# DIFF_REVIEW_MAX_LINES_PER_SEGMENT=400

# Optional scheduler tuning
# ENABLE_BUG_SCAN=true
# BUG_SCAN_INTERVAL_MINUTES=60
# BUG_SCAN_MAX_PRS_PER_REPO=10
# BUG_SCAN_POST_COMMENTS=false
# BUG_SCAN_SKIP_UNCHANGED=true
# BUG_SCAN_RUN_ON_START=false

# When true, PR reviews (webhook + scheduled scan) run only for users who have at least one non-revoked API key in the DB.
# The browser cannot send a pasted key to GitHub; this checks MongoDB only. Default: unset/false.
# REQUIRE_API_KEY_FOR_REVIEWS=true
